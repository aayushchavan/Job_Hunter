# ── Database ──────────────────────────────────────────────────────────────────
# Option A: Local PostgreSQL
# DATABASE_URL=postgresql+asyncpg://jobhunter:your_password@localhost:5432/jobhunter
# DATABASE_URL_SYNC=postgresql://jobhunter:your_password@localhost:5432/jobhunter

# Option B: Supabase (Recommended)
# Find in: Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI
# Note: In DATABASE_URL use '+asyncpg' and add '?ssl=require'. For special characters in password, URL-encode them (e.g. @ -> %40).
DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?ssl=require
DATABASE_URL_SYNC=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# ── Security Keys ─────────────────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-random-32-byte-hex-string
ENCRYPTION_KEY=change-this-to-a-fernet-compatible-key
JWT_SECRET=change-this-to-a-secure-jwt-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── AI Provider ───────────────────────────────────────────────────────────────
# Options: "gemini" (free 1,500 req/day), "local" (free keyword-based), "claude"
AI_PROVIDER=gemini

# Google Gemini API key (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Anthropic Claude (only if AI_PROVIDER=claude)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Job Scraping Sources ──────────────────────────────────────────────────────
# Adzuna Free Developer API (https://developer.adzuna.com/)
ADZUNA_APP_ID=your_adzuna_app_id_here
ADZUNA_APP_KEY=your_adzuna_app_key_here
ADZUNA_COUNTRY=in

# ── Auto-Apply Rules & Defaults ───────────────────────────────────────────────
AUTO_APPLY_ENABLED=false
AUTO_APPLY_MODE=safe
AUTO_APPLY_THRESHOLD=90
AUTO_APPLY_MAX_PER_DAY=10
AUTO_APPLY_DELAY_MIN_SEC=30
AUTO_APPLY_DELAY_MAX_SEC=120
AUTO_APPLY_MAX_RETRIES=3
AUTO_APPLY_TEST_MODE=true

# ── Application Configuration ─────────────────────────────────────────────────
APP_NAME=AI Job Hunter
APP_ENV=development
DEBUG=true
ALLOWED_ORIGINS=http://localhost:3000
